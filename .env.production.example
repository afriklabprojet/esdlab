# ============================================================
# Variables d'environnement — PRODUCTION
# Copier dans .env.production avec les vraies valeurs
# NE PAS committer .env.production
# ============================================================

# --- Base de données PostgreSQL (Neon, Supabase, Railway…) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
NEXTAUTH_SECRET="<générer avec: openssl rand -base64 32>"
NEXTAUTH_URL="https://esdlab.pro"

# --- Resend (emails) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@esdlab.pro"
RESEND_TO_EMAIL="contact@esdlab.pro"

# --- URL publique ---
NEXT_PUBLIC_SITE_URL="https://esdlab.pro"

# --- Analytics (optionnels) ---
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID="xxxxxxxxxx"

# --- Sentry (monitoring erreurs) ---
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oXXXXXXX.ingest.sentry.io/XXXXXXX"
SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxx"
SENTRY_ORG="esdlab"
SENTRY_PROJECT="digilab-corporate"
