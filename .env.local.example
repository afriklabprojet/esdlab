# Resend API Configuration
# ========================
# Obtenez votre clé API sur : https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email de l'expéditeur (doit être un domaine vérifié dans Resend)
RESEND_FROM_EMAIL=noreply@esdlab.com

# Email de destination pour recevoir les messages du formulaire
RESEND_TO_EMAIL=contact@esdlab.com

# Environnement (development | production)
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données MySQL (dev local) ---
DATABASE_URL="mysql://root:root@localhost:3306/digilab_dev"

# --- NextAuth ---
NEXTAUTH_SECRET="dev-secret-change-me-min-32-chars-long-aaaa"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin initial (créé par `npm run db:seed`) ---
ADMIN_EMAIL="admin@esdlab.pro"
ADMIN_PASSWORD="DigiLab2026!"
